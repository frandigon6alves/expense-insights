msgid "Amount"
msgstr "Importe"

msgid "By category"
msgstr "Por categoría"

msgid "CHAR"
msgstr "CARÁCTER"

msgid "CODE"
msgstr "CÓDIGO"

msgid "CSV layout"
msgstr "Formato del CSV"

msgid ""
"Categorize bank-statement CSV exports with your own rules and print a "
"monthly report: totals per category, change from the previous month, top "
"merchants and uncategorized transactions."
msgstr ""
"Clasifica los extractos bancarios exportados en CSV con tus propias "
"reglas e imprime un informe mensual: totales por categoría, variación "
"respecto al mes anterior, comercios principales y movimientos sin "
"categoría."

msgid "Category"
msgstr "Categoría"

msgid "Change"
msgstr "Variación"

#, python-brace-format
msgid "Could not understand the date {value!r}. Tried formats: {formats}."
msgstr "No se pudo interpretar la fecha {value!r}. Formatos probados: {formats}."

msgid "Count"
msgstr "Mov."

msgid "Date"
msgstr "Fecha"

msgid "Description"
msgstr "Descripción"

msgid "Every transaction matched a rule."
msgstr "Todos los movimientos coinciden con alguna regla."

#, python-brace-format
msgid ""
"Example:\n"
"  {prog} statement.csv --rules rules.toml --month 2026-03"
msgstr ""
"Ejemplo:\n"
"  {prog} extracto.csv --rules reglas.toml --month 2026-03"

#, python-brace-format
msgid "Expense report for {month}"
msgstr "Informe de gastos de {month}"

msgid "Expenses"
msgstr "Gastos"

msgid "FILE"
msgstr "ARCHIVO"

msgid "FORMAT"
msgstr "FORMATO"

msgid "ISO 4217 currency of the amounts (default: from the rules file, else USD)"
msgstr ""
"moneda ISO 4217 de los importes (por defecto: la del archivo de reglas o "
"USD)"

msgid "Income"
msgstr "Ingresos"

msgid "Input"
msgstr "Entrada"

msgid "LANG"
msgstr "IDIOMA"

